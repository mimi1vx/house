# kernel/Makefile.aarch64 — closure build for HouseA64 (phase 4)
# Runs INSIDE the linux/arm64 container (make -f Makefile.aarch64).
#
#   make -f Makefile.aarch64        # compile only (ghc --make -no-link)
#   make -f Makefile.aarch64 clean
#
# The ghc --make driver follows imports from HouseA64.hs.
# HouseA64 is the reduced Main (help/lambda/preempt/wastemem + PL011 console).
# All other kernel modules not in the transitive closure are excluded (see
# excluded list below). The legacy i386 `kernel/Makefile` remains untouched.

GHC      ?= ghc
BUILD    := build-kernel

# Packages needed by the closure (H layer + console + parsers + Set)
PKGS := -package mtl -package array -package containers -package pretty

# Seed default-extensions replacing -fglasgow-exts -fallow-undecidable-instances
# -fallow-overlapping-instances. Final set is pinned here and in porting-log.
# OverlappingInstances now handled via per-instance OVERLAPPABLE/OVERLAPPING
# pragmas instead of the deprecated global flag.
EXTS := -XMultiParamTypeClasses \
        -XFunctionalDependencies \
        -XFlexibleInstances \
        -XFlexibleContexts \
        -XUndecidableInstances \
        -XImplicitParams \
        -XExistentialQuantification \
        -XScopedTypeVariables \
        -XRank2Types \
        -XKindSignatures \
        -XPatternGuards \
        -XForeignFunctionInterface \
        -XGeneralizedNewtypeDeriving

GHCFLAGS := -O1 -outputdir $(BUILD) -i. $(PKGS) $(EXTS) -Wall

# Default: compile-only check (no link). Mirrors platform Makefile idiom for
# verifying the closure compiles under stock GHC 9.14.
all:
	@mkdir -p $(BUILD)
	ghc --make -no-link HouseA64.hs $(GHCFLAGS)

# Force recompilation from scratch
force:
	@mkdir -p $(BUILD)
	ghc --make -no-link HouseA64.hs $(GHCFLAGS) -fforce-recomp

clean:
	rm -rf $(BUILD)

.PHONY: all force clean

# === Excluded-modules list (per-module justification) =====================
# The following modules/files are NOT in the HouseA64 closure and are
# deliberately excluded from the aarch64 build (bare-minimum shell):
#
#  IA32 / x86-specific drivers (no aarch64 equivalent on QEMU virt):
#    H.IOPorts (x86 in/out port FFI — no aarch64 MMIO; consumers excluded)
#    Kernel.Driver.IA32.Screen, Kernel.Driver.IA32.VbeGraphics, Kernel.Driver.IA32.Reboot
#    H.All (re-exports IOPorts), H.IRQ? (legacy PIC PIC)
#
#  Graphics / window system / Gadgets stack (VBE/GIF/Gadgets/lib/*):
#    Gadgets/*, Gadgets/Images/*, Gadgets/lib/*, GfxBenchmark, DescribeGIF,
#    GIFparser, Demo, Util.FixedFont, Util.FontDecode (fonts.hf), DrawGIF etc.
#
#  Network stack (NE2000 / Intel8255x on ISA virt, no virtio yet):
#    Net/*, Kernel.Driver.NE2000/*, Kernel.Driver.Intel8255x/*
#
#  PCI (no PCI devices required for PL011 shell; DevInfo/ParseVendors use Data.PackedString):
#    Kernel.PCI/*, Kernel.PCI.Probe, DevTree, ConfigSpace, BaseAddr, DevInfo, ParseVendors, PCIBridge
#
#  User-mode / AOut execution (no multiboot modules on -kernel boot path):
#    Kernel.UserProc, Kernel.UserProcModel, Kernel.AOut, Kernel.AOutModel,
#    Kernel.GrubModules (fonts.hf/pci.ids.gz), H.UserMode, H.Grub, SimpleExec, UserProc
#
#  PS/2 / mouse / CMOS / RTC (replaced by PL011 UART in phase 4/5):
#    Kernel.Driver.PS2, Kernel.Driver.Mouse, Kernel.Driver.CMOS,
#    Kernel.Driver.Keyboard decoders remain (arch-independent interpreter),
#    but launchKeyboardDriver (PS2 hardware) is excluded — phase 4 passes empty Chan,
#    phase 5 wires UART RX.
#
#  Osker / Hovel / DomOS4 / L4 (research OS integrations):
#    Hovel.hs, L4/*, DOpOS4*,
#
#  user/ directory (example user programs, not kernel)
#
#  Confirmed absent from closure (ghc --make -v0 / import-closure walk):
#    Data.PackedString consumers: Kernel.PCI.DevInfo, Kernel.PCI.ParseVendors (both excluded)
#    H.IOPorts consumers: SimpleExec, CMOS, PS2, NE2000, Intel8255x, IA32/Screen,
#                         PCI/ConfigSpace, H.All — all excluded, so IOPorts itself
#                         compiles (pure FFI decls) but is unused-not-gated.
#
#  Kept in closure: H.Monad, H.Concurrency, H.Interrupts (GIC-native), H.VirtualMemory
#  (aarch64), H.Utils, H.Mutable, H.AdHocMem, Kernel.Debug, Kernel.Console,
#  Kernel.Types.Console, Kernel.LineEditor, Kernel.Driver.Keyboard (interpreter),
#  Kernel.Driver.PL011, Monad.Util, Util.CmdLineParser, Util.Grammar, Util.PM,
#  Util.Word12 (used by PhysicalMemory), etc. Exact set falls out of ghc --make.
# ===========================================================================
