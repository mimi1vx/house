#!/usr/bin/expect -f
# EL0 TLS clobber harness: a process that writes garbage TPIDR_EL0 then
# parks must not compromise the kernel; the process prints tls-ok and the
# shell prompt returns.
# Usage: expect scripts/qemu-tls-el0.exp <kernel.bin> [marker] [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout_arg [lindex $argv 2]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq "" || $marker eq "hvf" || $marker eq "tcg"} {
    set smp $mem
    set mem $accel
    set accel $marker
    set marker "tls-ok"
}
if {$marker eq ""} { set marker "tls-ok" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
if {$timeout_arg eq "" || $timeout_arg == 0} {
    if {$accel eq "tcg"} { set timeout 90 } else { set timeout 60 }
} else {
    set timeout $timeout_arg
}
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "run /bin/tls_clobber\r"
expect {
    -re "tls-ok" { puts "\nPASS: tls-ok printed after TPIDR clobber + park" }
    timeout { puts "\nFAIL: tls-ok timeout (kernel TLS clobbered?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before tls-ok"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after tls probe (kernel survived)" }
    timeout { puts "\nFAIL: prompt after tls probe timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after tls probe"; exit 1 }
}
catch {exec kill -9 [exp_pid]}
exit 0
