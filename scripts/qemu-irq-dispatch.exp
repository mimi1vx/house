#!/usr/bin/expect -f
# IRQ-dispatcher wedge gate: `virtio init` forks the transport IRQ dispatcher,
# whose house_pipe_wait spins in wfe inside an unsafe FFI call and so holds the
# RTS capability it was forked with. The shell must answer every subsequent
# round, and `virtio status` must answer after the last one. Pinned to -smp 1:
# with more capabilities the dispatcher and the shell run apart and the wedge
# is not observable at all.
# Usage: expect scripts/qemu-irq-dispatch.exp <house.bin> [timeout] [accel] [mem] [smp] [-- extra qemu args]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 45}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
set qemu_extra [lrange $argv 5 end]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 1 }
log_user 1
source [file join [file dirname [info script]] house.exp]
# Plain `-M virt` on purpose: the guest probes all 32 virtio-mmio transports, so
# no machine property is needed (and an 8-transport machine makes the scan read
# 24 addresses with no device behind them, which times out under tcg). The blk
# device lands on the last free transport, so its slot is discovered, not
# hardcoded. Also force modern virtio else queue setup fails.
set cmd "qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 -global virtio-mmio.force-legacy=false -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio"
foreach a $qemu_extra {
    if {$a eq "--"} { continue }
    append cmd " $a"
}
puts "SPAWN: $cmd"
eval spawn $cmd
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
# The dispatcher starts at boot now, so the ring has a consumer from the first
# Haskell instruction. Any IRQ lost before that is counted; this boot path
# arms virtio SPIs only later, so the pre-dispatch count must be zero.
expect {
    -re {pre-dispatch ring drops=(\d+)} {
        if {$expect_out(1,string) != 0} {
            puts "\nFAIL: $expect_out(1,string) IRQ ring drops before dispatcher start"
            catch {exec kill -9 [exp_pid]}
            exit 1
        }
        puts "\nPASS: no IRQ ring drops before dispatcher start"
    }
    timeout { puts "\nFAIL: pre-dispatch ring drops timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before pre-dispatch report"; exit 1 }
}
# Unbraced on purpose: -re {"> "} searches for the literal "> " and matches
# nothing, which looks exactly like a hang.
house_prompt "saw prompt"
# Non-vacuity precondition: the block device really is in a guest slot, so a
# missing device can never read as a pass.
send "virtio scan\r"
set blkSlot ""
expect {
    -re {virtio slot (\d+): device_id=2} { set blkSlot $expect_out(1,string); puts "\nPASS: virtio scan sees the blk device at slot $blkSlot" }
    timeout { puts "\nFAIL: virtio scan timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof during virtio scan"; exit 1 }
}
house_prompt "prompt after scan"
# Three init/teardown rounds on one slot. Every pattern matches a command's
# output, never the prompt: the line editor redraws the prompt during echo and
# a prompt match reports 0 ms for everything.
set maxms 0
for {set i 0} {$i < 3} {incr i} {
    set t0 [clock milliseconds]
    send "virtio init $blkSlot\r"
    expect {
        -re "ok device_id=" {}
        timeout { puts "\nFAIL: virtio init round $i never answered (dispatcher wedged the capability)"; catch {exec kill -9 [exp_pid]}; exit 1 }
        eof { puts "\nFAIL: eof during virtio init round $i"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    set dt [expr {[clock milliseconds] - $t0}]
    if {$dt > $maxms} { set maxms $dt }
    puts "\nPASS: virtio init round $i answered in ${dt}ms"
    house_prompt "prompt after init round $i"
    send "virtio teardown $blkSlot\r"
    expect {
        -re "teardown ok" {}
        timeout { puts "\nFAIL: virtio teardown round $i never answered"; catch {exec kill -9 [exp_pid]}; exit 1 }
        eof { puts "\nFAIL: eof during virtio teardown round $i"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after teardown round $i"
    puts "\nPASS: virtio teardown round $i ok"
}
# virtioStatusAll prints slots 0..31 unconditionally, so this always has output:
# a machine that wedged quietly cannot pass by timing out the same way.
send "virtio status\r"
expect {
    -re "status=0x" { puts "\nPASS: virtio status still answers" }
    timeout { puts "\nFAIL: virtio status never answered after the init rounds"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof during virtio status"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
puts "\nPASS: irq-dispatch ok (3 rounds, ${maxms}ms init max)"
catch {exec kill -9 [exp_pid]}
exit 0