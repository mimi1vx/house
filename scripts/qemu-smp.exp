#!/usr/bin/expect -f
# SMP verification for House/aarch64 (N cores, Haskell parallel).
# Usage: expect scripts/qemu-smp.exp <kernel.elf> [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 60}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
source [file join [file dirname [info script]] house.exp]
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
house_prompt "saw prompt"
send "smp\r"
expect {
    -re "smp: $smp cores online" { puts "\nPASS: smp $smp cores online" }
    timeout { puts "\nFAIL: smp timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before smp"; exit 1 }
}
house_prompt "prompt after smp"
send "caps\r"
expect {
    -re "caps $smp" { puts "\nPASS: caps $smp" }
    timeout { puts "\nFAIL: caps timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before caps"; exit 1 }
}
house_prompt "prompt after caps"
send "parfib 20\r"
expect {
    -re "6765" { puts "\nPASS: parfib 20 => 6765" }
    timeout { puts "\nFAIL: parfib timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before parfib"; exit 1 }
}
house_prompt "prompt after parfib"
send "mvar 20\r"
expect {
    -re "mvar ok" { puts "\nPASS: mvar ok" }
    timeout { puts "\nFAIL: mvar timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before mvar"; exit 1 }
}
puts "\nPASS: smp interactive ok"
catch {exec kill -9 [exp_pid]}
exit 0
