#!/usr/bin/expect -f
# EL0 fd/brk harness (multiprocess step 7): per-pid fd table over the
# park/resume ring (OPEN/READ/CLOSE cat probe) + brk grow-and-touch probe.
# Usage: expect scripts/qemu-fd-el0.exp <kernel.bin> [marker] [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout_arg [lindex $argv 2]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq "" || $marker eq "hvf" || $marker eq "tcg"} {
    set smp $mem
    set mem $accel
    set accel $marker
    set marker "fd-el0-ok"
}
if {$marker eq ""} { set marker "fd-el0-ok" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
if {$timeout_arg eq "" || $timeout_arg == 0} {
    if {$accel eq "tcg"} { set timeout 90 } else { set timeout 60 }
} else {
    set timeout $timeout_arg
}
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "fdtest\r"
expect {
    -re "fdtest ok" { puts "\nPASS: EL1 per-pid fdtest ok (incl. cross-pid EBADF)" }
    timeout { puts "\nFAIL: fdtest timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before fdtest ok"; exit 1 }
}
expect {
    -re "> " {}
    timeout { puts "\nFAIL: prompt after fdtest timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
send "run /bin/cat\r"
expect {
    -re "hello fd el0" { puts "\nPASS: EL0 cat echoed /probe.txt" }
    timeout { puts "\nFAIL: cat content timeout (OPEN/READ ring wedged?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before cat content"; exit 1 }
}
expect {
    -re "cat ok" { puts "\nPASS: EL0 cat ok (CLOSE resumed 0)" }
    timeout { puts "\nFAIL: cat ok timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before cat ok"; exit 1 }
}
expect {
    -re "ok exit 0" { puts "\nPASS: cat ok exit 0" }
    timeout { puts "\nFAIL: cat exit timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before cat exit"; exit 1 }
}
expect {
    -re "> " {}
    timeout { puts "\nFAIL: prompt after cat timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
send "run /bin/brk\r"
expect {
    -re "brk ok" { puts "\nPASS: EL0 brk grew 2 pages and touched them" }
    timeout { puts "\nFAIL: brk ok timeout (BRK ring wedged?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before brk ok"; exit 1 }
}
expect {
    -re "ok exit 0" { puts "\nPASS: brk ok exit 0" }
    timeout { puts "\nFAIL: brk exit timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before brk exit"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt at end" }
    timeout { puts "\nFAIL: final prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof at end"; exit 1 }
}
puts "\nPASS: $marker"
catch {exec kill -9 [exp_pid]}
exit 0
