#!/usr/bin/expect -f
# Fault-budget harness: a scan across the user window must be capped at the
# per-process budget (10% of buddy) with ENOMEM, reaped, and the kernel must
# reach its next prompt inside the timeout.
# Usage: expect scripts/qemu-house-fault-budget.exp <kernel.bin> [marker] [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout_arg [lindex $argv 2]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq "" || $marker eq "hvf" || $marker eq "tcg"} {
    set smp $mem
    set mem $accel
    set accel $marker
    set marker "fault-budget-ok"
}
if {$marker eq ""} { set marker "fault-budget-ok" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
if {$timeout_arg eq "" || $timeout_arg == 0} {
    if {$accel eq "tcg"} { set timeout 180 } else { set timeout 120 }
} else {
    set timeout $timeout_arg
}
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "spawn /bin/faultbudget\r"
expect {
    -re {spawned pid ([0-9]+)} { set p $expect_out(1,string); puts "\nPASS: spawned budget scanner pid $p" }
    timeout { puts "\nFAIL: spawn timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before spawn"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after spawn (kernel alive under scan)" }
    timeout { puts "\nFAIL: prompt after spawn timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after spawn"; exit 1 }
}
send "wait $p\r"
expect {
    -re "ok exit 1" { puts "\nPASS: scanner reaped exit 1 (capped, not spun)" }
    -re "ok exit 2" { puts "\nFAIL: scanner exited 2 (budget did not cap)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    -re "budget uncapped" { puts "\nFAIL: scanner survived cap"; catch {exec kill -9 [exp_pid]}; exit 1 }
    timeout { puts "\nFAIL: reap timeout (scan livelocked?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before reap"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after reap (kernel survived)" }
    timeout { puts "\nFAIL: final prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof at end"; exit 1 }
}
puts "\nPASS: $marker"
catch {exec kill -9 [exp_pid]}
exit 0
