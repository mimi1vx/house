#!/usr/bin/expect -f
# Syscall mask harness: spawn the svcmask probe, revoke WRITE for that pid,
# and prove the next write degrades to ENOSYS (exit 0) while the shell lives.
# Usage: expect scripts/qemu-svcmask.exp <kernel.bin> [marker] [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout_arg [lindex $argv 2]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq "" || $marker eq "hvf" || $marker eq "tcg"} {
    set smp $mem
    set mem $accel
    set accel $marker
    set marker "svcmask-ok"
}
if {$marker eq ""} { set marker "svcmask-ok" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
if {$timeout_arg eq "" || $timeout_arg == 0} {
    if {$accel eq "tcg"} { set timeout 90 } else { set timeout 60 }
} else {
    set timeout $timeout_arg
}
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "spawn /bin/svcmask\r"
expect {
    -re {spawned pid ([0-9]+)} { set p1 $expect_out(1,string); puts "\nPASS: spawned svcmask pid $p1" }
    timeout { puts "\nFAIL: spawn svcmask timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before spawn svcmask"; exit 1 }
}
send "svcmask $p1 1\r"
expect {
    -re "svcmask ok" { puts "\nPASS: narrowed write for pid $p1" }
    timeout { puts "\nFAIL: svcmask verb timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before svcmask ok"; exit 1 }
}
expect {
    -re "> " {}
    timeout { puts "\nFAIL: prompt after svcmask timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after svcmask"; exit 1 }
}
send "wait $p1\r"
expect {
    -re "ok exit 0" { puts "\nPASS: revoked write reaped exit 0 (ENOSYS observed)" }
    timeout { puts "\nFAIL: wait timeout (probe hung?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before wait"; exit 1 }
}
expect {
    -re "> " {}
    timeout { puts "\nFAIL: prompt after wait timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after wait"; exit 1 }
}
send "uname\r"
expect {
    -re "House" { puts "\nPASS: shell still lives after revoke" }
    timeout { puts "\nFAIL: shell dead after revoke"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before uname"; exit 1 }
}
expect {
    -re "> " {}
    timeout { puts "\nFAIL: final prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof at end"; exit 1 }
}
puts "\nPASS: $marker"
catch {exec kill -9 [exp_pid]}
exit 0
