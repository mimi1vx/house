#!/usr/bin/expect -f
# Boot the House aarch64 kernel (phase 4) and assert the welcome banner via PL011.
# Usage: expect scripts/qemu-house.exp <kernel.elf> [marker] [timeout] [accel] [mem]
# Defaults: marker="Welcome to the House shell", timeout=30, accel=hvf, mem=4G
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout [expr {[lindex $argv 2] > 0 ? [lindex $argv 2] : 30}]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq ""} { set marker "Welcome to the House shell" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel
expect {
    -re $marker {
        puts "\nPASS: saw /$marker/"
    }
    timeout {
        puts "\nFAIL: timed out waiting for /$marker/"
        catch {exec kill -9 [exp_pid]}
        exit 1
    }
    eof {
        puts "\nFAIL: qemu exited before marker appeared"
        exit 1
    }
}
# No -initrd on the spawn line: pid1 fails closed and the emergency
# shell (not the full shell) must answer.
expect {
    -re "initramfs: init fail no init" { puts "\nPASS: init fail closed" }
    timeout { puts "\nFAIL: init fail timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before init fail"; exit 1 }
}
expect {
    -re "emergency shell" { puts "\nPASS: emergency banner" }
    timeout { puts "\nFAIL: emergency banner timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency banner"; exit 1 }
}
expect {
    -re "emergency> " { puts "\nPASS: emergency prompt" }
    timeout { puts "\nFAIL: emergency prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency prompt"; exit 1 }
}
send "help\r"
expect {
    -re "emergency commands" { puts "\nPASS: emergency help" }
    timeout { puts "\nFAIL: emergency help timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency help"; exit 1 }
}
expect {
    -re "emergency> " { puts "\nPASS: prompt after help" }
    timeout { puts "\nFAIL: prompt after help timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
send "uname\r"
expect {
    -re "House" { puts "\nPASS: emergency uname" }
    timeout { puts "\nFAIL: emergency uname timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency uname"; exit 1 }
}
expect {
    -re "emergency> " { puts "\nPASS: prompt after uname" }
    timeout { puts "\nFAIL: prompt after uname timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
send "dmesg\r"
expect {
    -re "init fail" { puts "\nPASS: emergency dmesg shows init fail" }
    timeout { puts "\nFAIL: emergency dmesg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency dmesg"; exit 1 }
}
expect {
    -re "emergency> " { puts "\nPASS: prompt after dmesg" }
    timeout { puts "\nFAIL: prompt after dmesg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
send "bogus-verb\r"
expect {
    -re "unknown command" { puts "\nPASS: emergency unknown command" }
    timeout { puts "\nFAIL: emergency unknown timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before emergency unknown"; exit 1 }
}
expect {
    -re "emergency> " { puts "\nPASS: prompt after unknown" }
    timeout { puts "\nFAIL: final prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
puts "\nPASS: emergency shell ok"
catch {exec kill -9 [exp_pid]}
exit 0
