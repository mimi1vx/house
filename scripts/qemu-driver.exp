#!/usr/bin/expect -f
# Driver framework test for House/aarch64 (Track 2).
# Registry + dmesg + virtio scan + SPI plumbing + ns + ramfs + IPC.
# Usage: expect scripts/qemu-driver.exp <kernel.elf> [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 30}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
set qemu_extra [lrange $argv 5 end]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
source [file join [file dirname [info script]] house.exp]
# Plain `-M virt` on purpose (same shape as qemu-virtio-blk.exp): the guest
# probes all 32 virtio-mmio transports, so the blk device lands on the last
# free transport and its slot is discovered from `virtio scan`, not hardcoded.
# force-legacy=false: modern virtio, else queue setup fails with legacy mode.
set cmd "qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 -global virtio-mmio.force-legacy=false -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio"
foreach a $qemu_extra {
    if {$a eq "--"} { continue }
    append cmd " $a"
}
puts "SPAWN: $cmd"
eval spawn $cmd
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
house_prompt "saw prompt"
# dmesg should contain framework online
send "dmesg\r"
expect {
    -re "House driver framework online" { puts "\nPASS: dmesg framework online" }
    timeout { puts "\nFAIL: dmesg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after dmesg"
# lsdev should run without hang (empty at boot) and name the IRQ counter
send "lsdev\r"
expect {
    -re "irq drops=" { puts "\nPASS: lsdev names irq drops" }
    timeout { puts "\nFAIL: lsdev timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "lsdev empty ok"
# virtio scan should print slot 0 (empty on vanilla virt)
send "virtio scan\r"
expect {
    -re "virtio slot 0" { puts "\nPASS: virtio scan slot 0" }
    timeout { puts "\nFAIL: virtio scan timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after virtio scan"
# ns ls still functional
send "ns ls\r"
house_prompt "ns ls after virtio scan"
# register pl011 via ns, then lsdev should list pl011 if driver registry wired?
# Currently registry is separate; we test ns reg path and later lsdev shows empty or pl011.
# Use ns reg pl011 to launch server
send "ns reg pl011\r"
expect {
    -re "registered pl011" { puts "\nPASS: ns reg pl011" }
    timeout { puts "\nFAIL: ns reg pl011 timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ns reg"
send "lsdev\r"
expect {
    -re "irq drops=" { puts "\nPASS: lsdev names irq drops after reg" }
    timeout { puts "\nFAIL: lsdev after reg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "lsdev after ns reg"
# dmesg should have virtio slot logs
send "dmesg\r"
expect {
    -re "virtio slot" { puts "\nPASS: dmesg has virtio slot" }
    timeout { puts "\nFAIL: dmesg virtio timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after second dmesg"
# ramfs still live
send "write /a hello\r"
house_prompt "write /a hello"
send "cat /a\r"
expect {
    -re "hello" { puts "\nPASS: cat /a -> hello" }
    timeout { puts "\nFAIL: cat /a timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after cat"
# ipc ping pl011 still ok
send "ipc ping pl011\r"
expect {
    -re "ok" { puts "\nPASS: ipc ping pl011 -> ok" }
    timeout { puts "\nFAIL: ipc ping timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ipc ping"
# S3 (house-oz9.11) fault-injection stanza: a real blk driver owns a
# narrowed+supervised fault domain; each hostile class (bad MMIO offset,
# unmapped VA, tampered queue-PA stand-in) is parked as a genuine 0x1D
# FAULT_KILL through the real slot protocol, and the supervised path must
# reap only that driver and re-arm its root (kill + reinstall in dmesg,
# endpoint alive afterwards).
send "virtio scan\r"
set blkSlot ""
expect {
    -re {virtio slot (\d+): device_id=2} { set blkSlot $expect_out(1,string); puts "\nPASS: blk device at slot $blkSlot" }
    timeout { puts "\nFAIL: no blk device in scan (driver fault needs -device)"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after blk slot scan"
send "blk init $blkSlot\r"
expect {
    -re {ok capacity=[1-9][0-9]* sectors} { puts "\nPASS: blk init $blkSlot" }
    timeout { puts "\nFAIL: blk init $blkSlot timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after blk init"
set drvName "virtio-blk$blkSlot"
send "dmesg\r"
expect {
    -re "driver root: $drvName slot $blkSlot asid" { puts "\nPASS: dmesg narrowed+supervised root for $drvName" }
    timeout { puts "\nFAIL: no narrowed root for $drvName"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
expect {
    -re "narrowed\\+supervised" { puts "\nPASS: dmesg root narrowed+supervised" }
    timeout { puts "\nFAIL: root not narrowed+supervised"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after root dmesg"
foreach cls {offset unmapped queuepa} {
    send "driver fault $drvName $cls\r"
    expect {
        -re "driver fault $cls ok kill\\+restart" { puts "\nPASS: driver fault $cls kill+restart" }
        -re "driver fault: " { puts "\nFAIL: driver fault $cls refused/no-restart"; catch {exec kill -9 [exp_pid]}; exit 1 }
        timeout { puts "\nFAIL: driver fault $cls timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after driver fault $cls"
    send "dmesg\r"
    expect {
        -re "driver fault kill $drvName va=" { puts "\nPASS: dmesg kill attributed to $drvName ($cls)" }
        timeout { puts "\nFAIL: dmesg missing kill for $drvName ($cls)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    expect {
        -re "driver root reinstalled: $drvName " { puts "\nPASS: dmesg root re-armed for $drvName ($cls)" }
        timeout { puts "\nFAIL: dmesg missing reinstall for $drvName ($cls)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after dmesg $cls"
    send "blk status $blkSlot\r"
    expect {
        -re "capacity" { puts "\nPASS: blk status survives $cls kill" }
        timeout { puts "\nFAIL: blk status timeout after $cls kill"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after blk status $cls"
}
puts "\nPASS: fault-injection offset+unmapped+queuepa kill+restart ok"
# burst 5 virtio scans without deadlock
for {set i 0} {$i < 5} {incr i} {
    send "virtio scan\r"
    expect {
        -re "virtio slot 0" {}
        timeout { puts "\nFAIL: burst virtio scan $i timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after burst scan $i"
}
puts "\nPASS: burst 5 virtio scans ok"
puts "\nPASS: driver ok"
catch {exec kill -9 [exp_pid]}
exit 0
