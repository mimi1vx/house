#!/usr/bin/expect -f
# Initramfs test: boot with QEMU -initrd, assert unpack + /sbin/init + manifest.
# Usage: expect scripts/qemu-initramfs.exp <kernel.bin> [timeout] [accel] [mem] [smp] [-- extra qemu args]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 60}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
set qemu_extra [lrange $argv 5 end]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
source [file join [file dirname [info script]] house.exp]
set cmd "qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 -smp $smp -m $mem -nographic -kernel $kernel"
foreach a $qemu_extra {
    if {$a eq "--"} { continue }
    append cmd " $a"
}
puts "SPAWN: $cmd"
eval spawn $cmd
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "initramfs: 35 files" { puts "\nPASS: initramfs unpacked 35 files" }
    timeout { puts "\nFAIL: initramfs marker timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before initramfs marker"; exit 1 }
}
set saw_pid 0
set saw_up 0
set saw_prompt 0
while {!$saw_pid || !$saw_up || !$saw_prompt} {
    expect {
        -re "init pid (\[0-9\]+)" { puts "\nPASS: pid1 launched"; set saw_pid 1 }
        -re "init up" { puts "\nPASS: /sbin/init running"; set saw_up 1 }
        -re "> " { puts "\nPASS: saw prompt"; set saw_prompt 1 }
        timeout { puts "\nFAIL: boot marker timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
        eof { puts "\nFAIL: eof before boot markers"; exit 1 }
    }
}
send "\r"
house_prompt "re-synced prompt"
send "ns ls\r"
expect {
    -re "empty" { puts "\nPASS: ns empty at boot (no demo servers)" }
    timeout { puts "\nFAIL: ns ls timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ns ls"
send "run /bin/ls /bin\r"
expect {
    -re "hello" { puts "\nPASS: /bin/ls lists hello" }
    timeout { puts "\nFAIL: ls output timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before ls output"; exit 1 }
}
house_prompt "prompt after ls"
send "cat /etc/house-servers\r"
expect {
    -re "endpoint-arg" { puts "\nPASS: manifest file intact" }
    timeout { puts "\nFAIL: cat manifest timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after cat"
# No block device is attached: a root-only dependency must fail closed.
send "run /bin/hello-dyn-missing\r"
expect {
    -re "ENOENT: missing dependency libc-missing.so.0" { puts "\nPASS: no-block dependency is ENOENT" }
    timeout { puts "\nFAIL: no-block dependency timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before no-block dependency"; exit 1 }
}
house_prompt "prompt after no-block dependency"
send "dmesg\r"
expect {
    -re "needed libc-missing.so.0: no initramfs or mounted-root candidate" { puts "\nPASS: no-block dependency logged" }
    timeout { puts "\nFAIL: no-block dmesg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after no-block dmesg"
send "run /bin/hello\r"
expect {
    -re "Hello from EL0" { puts "\nPASS: static hello survives no-block miss" }
    timeout { puts "\nFAIL: static hello timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before static hello"; exit 1 }
}
expect {
    -re "ok exit 0" { puts "\nPASS: static hello exit 0" }
    timeout { puts "\nFAIL: static hello exit timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after static hello"
puts "\nPASS: initramfs ok"
catch {exec kill -9 [exp_pid]}
exit 0
