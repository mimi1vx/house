#!/usr/bin/expect -f
# IPC microkernel test for House/aarch64 (Track 1b).
# L4 sync rendezvous, copy+grant, both ns+cap, hybrid Haskell/EL0.
# Usage: expect scripts/qemu-ipc.exp <kernel.elf> [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 30}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
source [file join [file dirname [info script]] house.exp]
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
house_prompt "saw prompt"
# ns ls is empty at boot (manifest ships no demo servers)
send "ns ls\r"
expect {
    -re "empty" { puts "\nPASS: ns ls empty at boot" }
    timeout { puts "\nFAIL: ns ls timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ns ls"
# register pl011 server
send "ns reg pl011\r"
expect {
    -re "registered pl011|pl011" { puts "\nPASS: ns reg pl011" }
    timeout { puts "\nFAIL: ns reg pl011 timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ns reg"
# ns ls should now list pl011
send "ns ls\r"
expect {
    -re "pl011" { puts "\nPASS: ns ls contains pl011" }
    timeout { puts "\nFAIL: ns ls after reg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ns ls pl011"
# ipc ping pl011 -> ok
send "ipc ping pl011\r"
expect {
    -re "ok" { puts "\nPASS: ipc ping pl011 -> ok" }
    timeout { puts "\nFAIL: ipc ping timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ipc ping"
# second ping to verify rendezvous not one-shot
send "ipc ping pl011\r"
expect {
    -re "ok" { puts "\nPASS: second ipc ping pl011 -> ok" }
    timeout { puts "\nFAIL: second ipc ping timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after second ping"
# ipc grant -> ok (page moved)
send "ipc grant\r"
expect {
    -re "ok" { puts "\nPASS: ipc grant -> ok" }
    timeout { puts "\nFAIL: ipc grant timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ipc grant"
# ramfs still live alongside IPC (no pool corruption)
send "rm /a\r"
house_prompt "rm /a (ignore)"
send "write /a hello\r"
house_prompt "write /a hello after ipc"
send "cat /a\r"
expect {
    -re "hello" { puts "\nPASS: cat /a -> hello after ipc" }
    timeout { puts "\nFAIL: cat /a after ipc timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after cat hello"
# burst 20 pings without deadlock at SMP_N=2
for {set i 0} {$i < 20} {incr i} {
    send "ipc ping pl011\r"
    expect {
        -re "ok" {}
        timeout { puts "\nFAIL: burst ping $i timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    }
    house_prompt "prompt after burst ping $i"
}
puts "\nPASS: burst 20 pings ok"
# wedged call degrades to WouldBlock + dmesg instead of hanging
send "ipc timeout pl011\r"
expect {
    -re "WouldBlock" { puts "\nPASS: ipc timeout degrades to WouldBlock" }
    timeout { puts "\nFAIL: ipc timeout hangs"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after ipc"
send "dmesg\r"
expect {
    -re "call timeout" { puts "\nPASS: dmesg names call timeout" }
    timeout { puts "\nFAIL: dmesg call timeout missing"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
house_prompt "prompt after dmesg"
puts "\nPASS: ipc ok"
catch {exec kill -9 [exp_pid]}
exit 0
