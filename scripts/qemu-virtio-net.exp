#!/usr/bin/expect -f
# Virtio-net test (Track 5).
# Usage: expect scripts/qemu-virtio-net.exp <kernel.elf> [timeout] [accel] [mem] [smp] [-- extra qemu args]
set kernel [lindex $argv 0]
if {[lindex $argv 1] ne ""} {
  set timeout [lindex $argv 1]
} else {
  set timeout 45
}
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
set qemu_extra [lrange $argv 5 end]
set has_netdev [string match "*-netdev*" [join $qemu_extra " "]]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
set cmd "qemu-system-aarch64 -accel $accel -cpu max -M virt,virtio-mmio-transports=8,gic-version=3 -global virtio-mmio.force-legacy=false -smp $smp -m $mem -nographic -kernel $kernel"
foreach a $qemu_extra {
    if {$a eq "--"} { continue }
    append cmd " $a"
}
puts "SPAWN: $cmd"
eval spawn $cmd
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re ">" { puts "\nPASS: saw prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "dmesg\r"
expect {
    -re "House driver framework online" { puts "\nPASS: dmesg framework online" }
    timeout { puts "\nFAIL: dmesg timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "lsdev\r"
expect { -re ">" { puts "\nPASS: lsdev" } timeout { puts "\nFAIL: lsdev timeout"; catch {exec kill -9 [exp_pid]}; exit 1 } }
send "virtio scan\r"
expect {
    -re "virtio slot 0" { puts "\nPASS: virtio scan slot 0" }
    timeout { puts "\nFAIL: virtio scan timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "virtio scan\r"
expect {
    -re "device_id=1" { puts "\nPASS: virtio scan device_id=1" }
    -re "virtio slot" {
        if {$has_netdev} { puts "\nFAIL: virtio scan no net device with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: virtio scan no net device (maybe no -netdev)" }
    }
    timeout { puts "\nFAIL: virtio scan2 timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
set netSlot 7
send "net init $netSlot\r"
expect {
    -re "ok.*mac=52:54:00:12:34:56" { puts "\nPASS: net init $netSlot ok mac" }
    -re "NetBadSlot|NetNotNet|BadSlot|BadVersion" {
        if {$has_netdev} { puts "\nFAIL: net init $netSlot no device with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: net init $netSlot no device (empty slot)" }
    }
    timeout { puts "\nFAIL: net init timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "ifconfig\r"
expect {
    -re "10.0.2.15" { puts "\nPASS: ifconfig 10.0.2.15" }
    -re "Net" {
        if {$has_netdev} { puts "\nFAIL: ifconfig error with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: ifconfig returned error (expected if no net)" }
    }
    timeout { puts "\nFAIL: ifconfig timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "arp ls\r"
expect { -re ">" { puts "\nPASS: arp ls" } timeout { puts "\nFAIL: arp ls timeout"; catch {exec kill -9 [exp_pid]}; exit 1 } }
send "ping 10.0.2.2\r"
expect {
    -re "64 bytes from 10.0.2.2|bytes from|ok" { puts "\nPASS: ping 10.0.2.2" }
    -re "Net" {
        if {$has_netdev} { puts "\nFAIL: ping error with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: ping returned error" }
    }
    timeout { puts "\nFAIL: ping timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "ping 10.0.2.2\r"
expect {
    -re "ok|bytes from" { puts "\nPASS: second ping" }
    timeout { puts "\nFAIL: second ping timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "udpecho 10.0.2.15 12345 hello-net\r"
expect {
    -re "ok|udpecho" { puts "\nPASS: udpecho" }
    timeout { puts "\nFAIL: udpecho timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "write /a hello\r"
expect { -re ">" { puts "\nPASS: write /a hello" } timeout { puts "\nFAIL: write timeout"; catch {exec kill -9 [exp_pid]}; exit 1 } }
send "cat /a\r"
expect { -re "hello" { puts "\nPASS: cat /a -> hello" } timeout { puts "\nFAIL: cat timeout"; catch {exec kill -9 [exp_pid]}; exit 1 } }
sleep 1
send "ns ls\r"
expect { -re ">" { puts "\nPASS: ns ls after net" } timeout { puts "\nFAIL: ns ls timeout"; catch {exec kill -9 [exp_pid]}; exit 1 } }
send "net teardown $netSlot\r"
expect {
    -re "teardown ok|ok" { puts "\nPASS: net teardown $netSlot" }
    -re "Net" {
        if {$has_netdev} { puts "\nFAIL: net teardown error with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: net teardown error" }
    }
    timeout { puts "\nFAIL: net teardown timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "net init $netSlot\r"
expect {
    -re "ok.*mac" { puts "\nPASS: net re-init $netSlot ok" }
    -re "Net" {
        if {$has_netdev} { puts "\nFAIL: net re-init error with -netdev present"; catch {exec kill -9 [exp_pid]}; exit 1 } else { puts "\nINFO: net re-init failed" }
    }
    timeout { puts "\nFAIL: net re-init timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
send "ping 10.0.2.2\r"
expect {
    -re "ok|bytes from" { puts "\nPASS: ping after re-init" }
    timeout { puts "\nFAIL: ping after re-init timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
}
sleep 1
# burst 5 scans without deadlock
for {set i 0} {$i < 5} {incr i} {
    send "virtio scan\r"
    sleep 1
}
puts "\nPASS: burst 5 scans ok"
puts "\nPASS: virtio-net ok"
catch {exec kill -9 [exp_pid]}
catch {close}
catch {wait}
exit 0
