#!/usr/bin/expect -f
# Fault-kill harness: an EL0 fault inside the window but unmapped is covered
# by the pager; faults outside the window (below and above) must reap the
# process with exit 1 while the kernel continues. EL1 wild pointers still
# halt (negative case lives in code review, not QEMU: halting QEMU would wedge
# the harness).
# Usage: expect scripts/qemu-fault-kill.exp <kernel.bin> [marker] [timeout] [accel] [mem] [smp]
set kernel [lindex $argv 0]
set marker [lindex $argv 1]
set timeout_arg [lindex $argv 2]
set accel [lindex $argv 3]
set mem [lindex $argv 4]
set smp [lindex $argv 5]
if {$marker eq "" || $marker eq "hvf" || $marker eq "tcg"} {
    set smp $mem
    set mem $accel
    set accel $marker
    set marker "fault-kill-ok"
}
if {$marker eq ""} { set marker "fault-kill-ok" }
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
if {$timeout_arg eq "" || $timeout_arg == 0} {
    if {$accel eq "tcg"} { set timeout 90 } else { set timeout 60 }
} else {
    set timeout $timeout_arg
}
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel -initrd build/initramfs.cpio
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
send "spawn /bin/faultkill low\r"
expect {
    -re {spawned pid ([0-9]+)} { set p1 $expect_out(1,string); puts "\nPASS: spawned low-faulter pid $p1" }
    timeout { puts "\nFAIL: spawn low timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before spawn low"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after low spawn" }
    timeout { puts "\nFAIL: prompt after low spawn timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after low spawn"; exit 1 }
}
send "wait $p1\r"
expect {
    -re "ok exit 1" { puts "\nPASS: low fault reaped exit 1 (core alive)" }
    timeout { puts "\nFAIL: low reap timeout (core halted?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before low reap"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after low reap" }
    timeout { puts "\nFAIL: prompt after low reap timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after low reap"; exit 1 }
}
send "spawn /bin/faultkill high\r"
expect {
    -re {spawned pid ([0-9]+)} { set p2 $expect_out(1,string); puts "\nPASS: spawned high-faulter pid $p2" }
    timeout { puts "\nFAIL: spawn high timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before spawn high"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after high spawn" }
    timeout { puts "\nFAIL: prompt after high spawn timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after high spawn"; exit 1 }
}
send "wait $p2\r"
expect {
    -re "ok exit 1" { puts "\nPASS: high fault reaped exit 1 (core alive)" }
    timeout { puts "\nFAIL: high reap timeout (core halted?)"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before high reap"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt at end" }
    timeout { puts "\nFAIL: final prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof at end"; exit 1 }
}
puts "\nPASS: $marker"
catch {exec kill -9 [exp_pid]}
exit 0
