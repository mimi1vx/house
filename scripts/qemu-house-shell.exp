#!/usr/bin/expect -f
# Interactive shell test for House/aarch64 (phase 5).
# Boots house.elf, waits for welcome + prompt, sends commands, checks output.
# Usage: expect scripts/qemu-house-shell.exp <kernel.elf> [timeout] [accel] [mem]
set kernel [lindex $argv 0]
set timeout [expr {[lindex $argv 1] > 0 ? [lindex $argv 1] : 30}]
set accel [lindex $argv 2]
set mem [lindex $argv 3]
set smp [lindex $argv 4]
if {$accel eq ""} { set accel hvf }
if {$mem eq ""} { set mem 4G }
if {$smp eq ""} { set smp 2 }
log_user 1
spawn qemu-system-aarch64 -accel $accel -cpu max -M virt,gic-version=3 \
    -smp $smp -m $mem -nographic -kernel $kernel
expect {
    -re "Welcome to the House shell" { puts "\nPASS: saw welcome" }
    timeout { puts "\nFAIL: welcome timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before welcome"; exit 1 }
}
# first prompt "> " comes from LineEditor getLine after welcome
expect {
    -re "> " { puts "\nPASS: saw prompt" }
    timeout { puts "\nFAIL: prompt timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before prompt"; exit 1 }
}
# help should print usage containing "Usage:"
send "help\r"
expect {
    -re "Usage:" { puts "\nPASS: help printed Usage" }
    timeout { puts "\nFAIL: help timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before help output"; exit 1 }
}
# next prompt
expect {
    -re "> " { puts "\nPASS: prompt after help" }
    timeout { puts "\nFAIL: prompt after help timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after help"; exit 1 }
}
send "lambda\r"
expect {
    -re "Too much to abstract" { puts "\nPASS: lambda output" }
    timeout { puts "\nFAIL: lambda timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before lambda"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after lambda" }
    timeout { puts "\nFAIL: prompt after lambda timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after lambda"; exit 1 }
}
send "wastemem 10\r"
expect {
    -re "55" { puts "\nPASS: wastemem 10 => 55" }
    timeout { puts "\nFAIL: wastemem timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before wastemem"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after wastemem" }
    timeout { puts "\nFAIL: prompt after wastemem timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after wastemem"; exit 1 }
}
# line-editor regression: small keystroke bursts (PL011 RX FIFO is 16 deep)
# with settles so no byte is lost to overrun on slow (tcg) guests.
# mid-line insert: echo md01ab, Left Left, X => runs "echo md01Xab"
send "echo "
after 200
send "md01ab"
after 200
send "\033\[D\033\[D"
after 300
send "X\r"
expect {
    -re "md01Xab\r*\n" { puts "\nPASS: mid-line insert" }
    timeout { puts "\nFAIL: mid-line insert timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before mid-line insert"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after insert" }
    timeout { puts "\nFAIL: prompt after insert timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after insert"; exit 1 }
}
# Backspace deletes the char before the cursor: echo md02abc, BS => md02ab
send "echo "
after 200
send "md02abc"
after 200
send "\177"
after 300
send "\r"
expect {
    -re "md02ab\r*\n" { puts "\nPASS: backspace delete" }
    timeout { puts "\nFAIL: backspace timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before backspace"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after backspace" }
    timeout { puts "\nFAIL: prompt after backspace timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after backspace"; exit 1 }
}
# forward Delete (ESC [ 3 ~) removes the char under the cursor with no
# "3~" leakage: echo md03ab, Left Left, Del => runs "echo md03b"
send "echo "
after 200
send "md03ab"
after 200
send "\033\[D\033\[D"
after 300
send "\033\[3~"
after 300
send "\r"
expect {
    -re "md03b\r*\n" { puts "\nPASS: forward delete" }
    timeout { puts "\nFAIL: forward delete timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before forward delete"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after forward delete" }
    timeout { puts "\nFAIL: prompt after forward delete timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after forward delete"; exit 1 }
}
# Tab path completion: echo /b<Tab> => echo /bin/
send "echo "
after 200
send "/b"
after 200
send "\t"
after 300
send "\r"
expect {
    -re "/bin/\r*\n" { puts "\nPASS: tab completion" }
    timeout { puts "\nFAIL: tab completion timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before tab completion"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after tab completion" }
    timeout { puts "\nFAIL: prompt after tab completion timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after tab completion"; exit 1 }
}
# Up recalls the previous line (echo /bin/) and re-runs it
send "\033\[A"
after 300
send "\r"
expect {
    -re "/bin/\r*\n" { puts "\nPASS: history recall" }
    timeout { puts "\nFAIL: history recall timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof before history recall"; exit 1 }
}
expect {
    -re "> " { puts "\nPASS: prompt after history" }
    timeout { puts "\nFAIL: prompt after history timeout"; catch {exec kill -9 [exp_pid]}; exit 1 }
    eof { puts "\nFAIL: eof after history"; exit 1 }
}
puts "\nPASS: shell interactive ok"
catch {exec kill -9 [exp_pid]}
exit 0
